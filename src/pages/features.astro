---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { FEATURE_GROUPS, KEYBOARD_SHORTCUTS } from '../lib/features';
import { NAV, SITE } from '../lib/site';
---
<Base
  title="Features"
  description="Every shipped feature in itemized: nested locations, expiration rules, automatic shopping list, barcode scanning, Zebra ZPL label printing, FTS5 search, and OIDC SSO."
>
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Features</p>
      <h1>Everything included, running on your hardware.</h1>
      <p class="lede">
        Every capability below is shipped in the single itemized binary with no paid tiers, add-on servers, or cloud subscriptions.
      </p>
      <nav class="jump-nav" aria-label="Feature groups">
        {FEATURE_GROUPS.map((group) => (
          <a href={`#${group.id}`}>{group.kicker}</a>
        ))}
      </nav>
    </div>
  </header>

  {FEATURE_GROUPS.map((group, idx) => (
    <section
      id={group.id}
      class:list={['section', idx % 2 === 1 && 'section-alt']}
      aria-labelledby={`${group.id}-title`}
    >
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{group.kicker}</p>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p class="lede">{group.lede}</p>
        </div>
        <div class:list={[group.items.length === 2 ? 'grid-2' : 'grid-3']}>
          {group.items.map((item) => (
            <article class="card">
              <div class="card-icon"><Icon name={group.icon} size={20} /></div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </article>
          ))}
        </div>

        {group.id === 'search-and-shortcuts' && (
          <div class="shortcut-grid" aria-label="Desktop keyboard shortcuts">
            {KEYBOARD_SHORTCUTS.map((sc) => (
              <div class="shortcut-row">
                <span>{sc.action}</span>
                <span class="shortcut-keys">
                  {sc.keys.map((k) => <kbd>{k}</kbd>)}
                </span>
              </div>
            ))}
          </div>
        )}

        {group.screenshots && group.screenshots.length === 1 && (
          <figure class="shot-stage">
            <img
              src={group.screenshots[0].src}
              alt={group.screenshots[0].alt}
              width={group.screenshots[0].width}
              height={group.screenshots[0].height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{group.screenshots[0].caption}</figcaption>
          </figure>
        )}

        {group.screenshots && group.screenshots.length > 1 && (
          <div class="shot-grid">
            {group.screenshots.map((shot) => (
              <figure class="shot-stage">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section section-alt" aria-labelledby="features-cta-title">
    <div class="wrap narrow">
      <h2 id="features-cta-title">Ready to try it yourself?</h2>
      <p class="lede">
        Test every workflow in the live demo or deploy itemized on your own server with Docker Compose.
      </p>
      <div class="cta-row" style="margin-top: 1.5rem;">
        <a class="btn btn-primary btn-large" href={SITE.demo}>
          <span>Try Live Demo</span>
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn-secondary btn-large" href={NAV.selfHost}>Self-Host Quick Start</a>
        <a class="btn btn-secondary btn-large" href={NAV.configuration}>Configuration Reference</a>
      </div>
    </div>
  </section>
</Base>
