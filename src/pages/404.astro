---
import Base from '../layouts/Base.astro';
import { NAV } from '../lib/site';
---
<Base
  title="Page not found"
  description="The page you requested does not exist on itemizedapp.com."
  noindex
>
  <section class="section">
    <div class="wrap narrow">
      <p class="kicker">404</p>
      <h1>Page not found</h1>
      <p class="lede">
        That address does not exist on this site. You can return to the home page, browse itemized’s features, or jump straight to the self-hosting guide.
      </p>
      <div class="cta-row" style="margin-top: 1.75rem;">
        <a class="btn btn-primary" href={NAV.home}>Back to Home</a>
        <a class="btn btn-secondary" href={NAV.features}>Explore Features</a>
        <a class="btn btn-secondary" href={NAV.selfHost}>Self-Host Guide</a>
      </div>
    </div>
  </section>
</Base>
