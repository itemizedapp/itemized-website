---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ENV_VARS, PRINTER_PROTOCOLS } from '../lib/config';
import { NAV } from '../lib/site';

const categories: { id: 'core' | 'oidc' | 'llm' | 'demo'; title: string; summary: string }[] = [
  {
    id: 'core',
    title: 'Core server & storage',
    summary: 'Listen port, SQLite database path, container permissions, reverse proxy trust, and canonical QR URL.',
  },
  {
    id: 'oidc',
    title: 'OIDC Single Sign-On',
    summary: 'Optional OpenID Connect authentication (Auth Code + PKCE) tested with Authentik, Authelia, Pocket ID, and Keycloak.',
  },
  {
    id: 'llm',
    title: 'Optional AI UPC normalization',
    summary: 'Optional LLM-assisted product naming and categorization after OpenFoodFacts barcode lookups, including local Ollama.',
  },
  {
    id: 'demo',
    title: 'Public demo mode',
    summary: 'Sandboxed evaluation mode with automatic periodic database resets.',
  },
];
---
<Base
  title="Configuration & Label Printing"
  description="Complete environment variable reference, OIDC SSO, optional AI barcode normalization, universal label printing drivers, and Visual Label Designer setup for itemized."
>
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Reference</p>
      <h1>Configuration &amp; Label Printing</h1>
      <p class="lede">
        Configure itemized with environment variables at startup, or edit instance settings directly in the in-app <strong>Settings</strong> page after first-run setup.
      </p>
      <nav class="jump-nav" aria-label="Configuration sections">
        <a href="#env-vars">Environment Variables</a>
        <a href="#printing">Label Printing &amp; Designer</a>
      </nav>
    </div>
  </header>

  <section class="section" id="env-vars" aria-labelledby="env-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Environment</p>
        <h2 id="env-title">Environment variables</h2>
        <p class="lede">
          All instance settings (except <code>PORT</code>, <code>DB_PATH</code>, <code>PUID</code>/<code>PGID</code>, <code>TRUST_PROXY</code>, and <code>DEMO_*</code>) can also be updated in <strong>Settings</strong> after setup.
        </p>
      </div>

      {categories.map((cat) => {
        const rows = ENV_VARS.filter((v) => v.category === cat.id);
        return (
          <div style="margin-bottom: 2.5rem;">
            <h3>{cat.title}</h3>
            <p class="muted" style="margin-bottom: 0.75rem;">{cat.summary}</p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Default</th>
                    <th scope="col">In-app UI</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((v) => (
                    <tr>
                      <td><code>{v.name}</code></td>
                      <td><code>{v.defaultValue}</code></td>
                      <td>
                        {v.inAppEditable ? <span class="badge">Editable</span> : <span class="muted">Env only</span>}
                      </td>
                      <td>{v.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section section-alt" id="printing" aria-labelledby="printing-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Universal Label Printing</p>
        <h2 id="printing-title">Supported printers &amp; Visual Label Designer</h2>
        <p class="lede">
          Itemized renders printer-agnostic QR labels on the server and prints directly to network thermal printers, CUPS/AirPrint printers, or local browser PDFs without a companion print server.
        </p>
      </div>

      <div class="grid-3">
        {PRINTER_PROTOCOLS.map((proto) => (
          <article class="card">
            <div class="card-head-row">
              <div class="card-icon" style="margin-bottom: 0;"><Icon name="printer" size={20} /></div>
              {proto.badge && <span class="badge">{proto.badge}</span>}
            </div>
            <h3>{proto.name}</h3>
            {proto.endpoint && <p>Example endpoint: <code>{proto.endpoint}</code></p>}
            <p>{proto.notes}</p>
            <ul class="printer-examples">
              {proto.examples.map((model) => (
                <li>{model}</li>
              ))}
            </ul>
            {proto.link && (
              <a class="card-link" href={proto.link.href} target="_blank" rel="noopener noreferrer">
                <span>{proto.link.label}</span>
                <Icon name="external-link" size={15} />
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="prose" style="margin-top: 2rem;">
        <h3>Label sizes and auto-detection</h3>
        <p>
          Every printer profile supports <strong>Auto-detect</strong> for IPP printers (querying the loaded roll size automatically when you save), built-in presets such as <code>2.25" x 1.25"</code> and Brother <code>DK-1209 62 x 29 mm</code>, or custom dimensions in <code>mm</code> or <code>in</code> along with configurable <strong>DPI</strong> and <strong>Die-Cut / Continuous</strong> media types.
        </p>
        <p>
          <strong>No label printer? No problem.</strong> Printing labels is optional. You can track groceries directly using their existing retail UPC barcodes, or use <strong>Browser Print / PDF</strong> with any printer already connected to your computer.
        </p>
        <h3>Visual Label Designer</h3>
        <p>
          Under <strong>Settings -&gt; Label Printing -&gt; Label Designer</strong>, design separate layouts for <strong>item</strong>, <strong>product</strong>, and <strong>location</strong> labels without writing raw printer commands:
        </p>
        <ul>
          <li>Place the optional <strong>QR Code</strong> and each field onto any cell of the <strong>3x3 anchor grid</strong> (<code>Top Left</code> through <code>Bottom Right</code>).</li>
          <li>Configure independent <strong>text alignment</strong> (<code>Left</code>, <code>Center</code>, or <code>Right</code>), <strong>font size</strong>, <strong>bold</strong>, and <strong>icons</strong> per field, and toggle or reorder fields freely.</li>
          <li>Use the <strong>Live Preview</strong> size switcher to inspect exact rendered output for any configured printer or label preset before saving, or restore defaults anytime with <strong>Reset to Default</strong>.</li>
        </ul>
        <h3>Product label modes</h3>
        <p>
          Each product lets you choose what prints automatically during <strong>Purchase</strong> and when opening, freezing, or thawing updates an item’s due date: <strong>No automatic label</strong> (<code>none</code>), <strong>One label per item</strong> (<code>per_item</code>, encoding a unique <code>/go/i/:id</code> QR), or <strong>One product label</strong> (<code>per_product</code>, encoding a reusable <code>/go/p/:id</code> QR).
        </p>
        <div class="callout">
          <p>
            <strong>Set <code>BASE_URL</code> before printing labels.</strong> If you print labels while running behind a reverse proxy, make sure <code>BASE_URL</code> points to your HTTPS domain (for example <code>https://itemized.example.com</code>) so scanning any QR label with your phone’s native camera opens the QR Quick Action screen reliably.
          </p>
        </div>
        <div class="cta-row" style="margin-top: 1.5rem;">
          <a class="btn btn-primary" href={NAV.selfHost}>
            <span>Back to Self-Host Guide</span>
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn-secondary" href={NAV.install}>Install Mobile PWA</a>
        </div>
      </div>
    </div>
  </section>
</Base>
